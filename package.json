{
  "name": "library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @library/web",
    "dev": "npm run dev --workspace @library/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run check:sql && npm run check:secrets && npm run check:plpgsql && npm run check:layout",
    "prove": "node tools/prove-guards.mjs && node tools/prove-secret-scanner.mjs",
    "check:sql": "node tools/check-sql.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "check:plpgsql": "node tools/check-plpgsql.mjs",
    "verify:live": "node --experimental-strip-types tools/verify-live.mjs",
    "check:layout": "node tools/check-layout.mjs"
  },
  "engines": {
    "node": ">=22.18"
  }
}
