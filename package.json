{
  "name": "library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @library/web",
    "dev": "npm run dev --workspace @library/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test",
    "prove": "node tools/prove-guards.mjs"
  },
  "engines": {
    "node": ">=22.18"
  }
}
