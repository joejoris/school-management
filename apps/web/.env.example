# Copy to .env.local and fill in. That file is gitignored; this one is not, and
# must never hold a real value.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# ── VITE_API_MODE ────────────────────────────────────────────────────
#
#   mock       records live in this browser. Nothing to configure, works with no
#              infrastructure, and is the default.
#   supabase   records live in Postgres. Needs the two values below.
VITE_API_MODE=mock

# ── The two Supabase values ───────────────────────────────────────────
#
# Left blank. Fill them in locally; do not paste them into a chat message, a
# commit, or anything that gets logged.
#
# Both are read at BUILD time, not at run time. Changing one needs a rebuild,
# which is why they belong here rather than in a settings screen.
#
# The anon key is public by design — it ships inside the browser bundle, and
# Supabase expects that. What makes it safe is that anon is revoked from every
# table in migration 0003 and may call exactly two functions.
#
# The database password is the real secret. It unlocks the whole database from
# anywhere, bypassing RLS entirely, and it is never in this project at all.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=